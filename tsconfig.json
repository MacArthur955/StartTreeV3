{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "js",
    "outDir": "dist/js",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noEmitOnError": true
  },
  "include": ["js/**/*.ts"]
}
