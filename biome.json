{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["**", "!**/dist"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "includes": ["app/src/helper/jsurl.ts"],
      "linter": {
        "rules": {
          "correctness": { "noInnerDeclarations": "off" },
          "suspicious": {
            "noAssignInExpressions": "off",
            "noImplicitAnyLet": "off"
          }
        }
      }
    }
  ]
}
